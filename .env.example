# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_optional_discord_guild_id_here

# AI Configuration (Google Gemini)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Backend & Security Settings
API_KEY=your_secret_admin_api_key_here
DATABASE_URL=sqlite:///./memorials.db

# System Behavior Workflow
# APPROVAL_MODE: MANUAL (requires admin slash command /approve) or AUTO (auto-publishes upon scan)
APPROVAL_MODE=MANUAL
SCAN_INTERVAL_HOURS=3

# Logging Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
